# Required: database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_supabase_publishable_key
INTERNAL_JOB_SECRET=replace_with_a_long_random_secret

# Required by the classifier, tracker parser, and deduplication
GEMINI_API_KEY=your_gemini_api_key

# AWS Bedrock (optional - uses Gemini if not set)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Discovery provider (required for Firecrawl opportunity discovery; server-only)
FIRECRAWL_API_KEY=fc_your_key
FIRECRAWL_SEARCH_LIMIT=5

# Optional notifications
RESEND_API_KEY=your_resend_api_key
DAILY_DIGEST_EMAIL=you@example.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Runtime and browser access
CORS_ORIGIN=http://localhost:3000
CRON_TIMEZONE=Asia/Kolkata
ENABLE_SCHEDULER=true
RUN_INITIAL_SCRAPE=false

# Override these only when you want a different schedule
INTERNSHIP_CRON=17 */6 * * *
HACKATHON_CRON=47 8,20 * * *
DIGEST_CRON=0 9 * * *
DEADLINE_CRON=0 8 * * *
FOLLOW_UP_CRON=0 10 * * *
DEDUPLICATION_CRON=0 2 * * 0

MAX_RETRIES=3
MAX_NEW_OPPORTUNITIES_PER_RUN=40

# GitHub Actions workflow dispatch (for manual trigger from UI)
GITHUB_PAT=your_github_personal_access_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
GITHUB_BRANCH=main

# Optional Telegram webhook verification
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional private HackerAgentRank service. Do not point this at a public, unauthenticated API.
HACKER_AGENT_RANK_URL=http://127.0.0.1:8000
HACKER_AGENT_RANK_API_KEY=
